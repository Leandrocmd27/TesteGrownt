@page
@model TesteGrownt.Pages.Departamentos.IndexModel

<h2>Departamentos</h2>

<a asp-page="Create" class="btn btn-primary mb-3">
    Novo Departamento
</a>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <input type="text"
               name="nome"
               value="@Model.Nome"
               class="form-control"
               placeholder="Nome do departamento" />
    </div>

    <div class="col-md-3">
        <button class="btn btn-secondary">Filtrar</button>
        <a asp-page="Index" class="btn btn-link">Limpar</a>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nome</th>
            <th>Departamento Superior</th>
            <th>Gerente</th>
            <th style="width: 140px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dep in Model.Departamentos)
        {
            <tr>
                <td>@dep.Nome</td>
                <td>@dep.DepartamentoSuperior?.Nome</td>
                <td>@dep.Gerente?.Nome</td>
                <td>
                    <a asp-page="Edit"
                       asp-route-id="@dep.Id"
                       class="btn btn-sm btn-warning">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@page
@model TesteGrownt.Pages.Colaboradores.CreateModel

<h2 class="mb-4">Novo Colaborador</h2>

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger alert-dismissible fade show"
     role="alert">
</div>


<div class="card">
    <div class="card-body">
        <form method="post" class="row g-3">

            <div class="col-md-6">
                <label class="form-label">Nome</label>
                <input asp-for="Colaborador.Nome" class="form-control" />
                <span asp-validation-for="Colaborador.Nome" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">CPF</label>
                <input asp-for="Colaborador.CPF" class="form-control cpf" />
                <span asp-validation-for="Colaborador.CPF" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label class="form-label">RG</label>
                <input asp-for="Colaborador.RG" class="form-control rg" />
                <span asp-validation-for="Colaborador.RG" class="text-danger"></span>
            </div>

            <div class="col-md-8">
                <label class="form-label">Departamento</label>

                @if (!Model.Departamentos.Any())
                {
                    <div class="alert alert-warning mb-0">
                        Nenhum departamento cadastrado.
                        O colaborador pode ser criado sem departamento.
                    </div>
                }
                else
                {
                    <select asp-for="Colaborador.DepartamentoId"
                            asp-items="Model.Departamentos"
                            class="form-select">
                        <option value="">Selecione</option>
                    </select>
                }
            </div>

            <div class="col-12 d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-success">
                    💾 Salvar
                </button>

                <a asp-page="Index" class="btn btn-secondary">
                    ↩ Voltar
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@page
@model TesteGrownt.Pages.Colaboradores.IndexModel

<h2 class="mb-4">Colaboradores</h2>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Nome</label>
                <input asp-for="Nome" class="form-control" placeholder="Nome do colaborador" />
            </div>

            <div class="col-md-3">
                <label class="form-label">CPF</label>
                <input asp-for="CPF" class="form-control" placeholder="CPF" />
            </div>

            <div class="col-md-2">
                <label class="form-label">RG</label>
                <input asp-for="RG" class="form-control" placeholder="RG" />
            </div>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    🔍 Filtrar
                </button>

                <a asp-page="Create" class="btn btn-success">
                    ➕ Novo
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>RG</th>
                    <th>Departamento</th>
                    <th>Gerente</th>
                    <th style="width: 120px">Ações</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Colaboradores.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Nenhum colaborador encontrado
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Colaboradores)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.CPF</td>
                            <td>@item.RG</td>
                            <td>@item.Departamento?.Nome</td>
                            <td>@item.Departamento?.Gerente?.Nome</td>
                            <td>
                                <a asp-page="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    ✏️ Editar
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
